# Copie para .env (ou .env.local) e preencha.

# Neon: Dashboard > Connect > copie a connection string "Pooled" (host com -pooler)
DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# https://developer.riotgames.com (a chave de desenvolvimento expira a cada 24h)
RIOT_API_KEY="RGAPI-00000000-0000-0000-0000-000000000000"

# Opcional. Formato "limite:janela_em_segundos". Padrão = limites da chave de desenvolvimento.
# RIOT_RATE_LIMITS="20:1,100:120"

# Leaguepedia (aba Worlds): crie em https://lol.fandom.com/wiki/Special:BotPasswords
# marcando só "Basic rights". O usuário fica no formato "SeuNome@nomedobot".
LEAGUEPEDIA_USER="SeuNome@opggclone"
LEAGUEPEDIA_PASSWORD="senha-gerada"
